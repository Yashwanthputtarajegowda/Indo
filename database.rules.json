{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "following": {
          ".read": "auth != null",
          "$targetUid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "followers": {
          ".read": "auth != null",
          "$followerUid": { ".write": false }
        }
      }
    },
    "usernames": {
      "$usernameKey": { ".read": "auth != null", ".write": false }
    },
    "mediaLikes": {
      "$mediaId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','createdAt']) && newData.child('uid').val() === auth.uid && newData.child('createdAt').isNumber()"
        }
      }
    },
    "savedMedia": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$mediaId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['mediaId','createdAt']) && newData.child('mediaId').val() === $mediaId && newData.child('createdAt').isNumber()"
        }
      }
    },
    "reelComments": {
      "$reelId": {
        ".read": "auth != null",
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid','text','createdAt']) && newData.child('uid').isString() && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('createdAt').isNumber()"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['type','actorUid','read','createdAt']) && newData.child('type').isString() && newData.child('actorUid').isString() && newData.child('read').isBoolean() && newData.child('createdAt').isNumber()"
        }
      }
    },
    "system": { ".read": false, ".write": false },
    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$conversationKey": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['conversationKey','otherUid','updatedAt']) && newData.child('conversationKey').isString() && newData.child('otherUid').isString() && newData.child('updatedAt').isNumber()"
        }
      }
    },
    "conversations": {
      "$conversationKey": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$messageId": {
            ".write": "auth != null && (!data.exists() || data.child('senderUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['senderUid','text','createdAt']) && newData.child('senderUid').isString() && newData.child('text').isString() && newData.child('createdAt').isNumber()"
          }
        }
      }
    }
  }
}
